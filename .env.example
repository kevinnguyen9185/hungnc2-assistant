# Copy to .env and fill in.  NEVER commit .env to git.
# chmod 600 .env

# --- Telegram (create bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=123456:ABC...

# --- OpenRouter (powers the Zalo everyday desk via DeepSeek) ---
# Key from https://openrouter.ai/keys
# Model used: deepseek/deepseek-v4-flash (set in config/openclaw.json)
OPENROUTER_API_KEY=sk-or-...

# --- Zalo ---
# Official Account bot token (if you use the OA route):
ZALO_BOT_TOKEN=
# If you use the "Zalo Personal" plugin instead, there is no token here —
# you log in by QR code during onboarding (see README step 6).

# --- GitHub (sync backbone: workers create/pull/push repos) ---
# Fine-grained PAT: https://github.com/settings/personal-access-tokens
# Scope it to the repos/org you want the assistant to touch.
# Contents: Read+Write, Administration: Read+Write (for `gh repo create`).
GH_TOKEN=
# Commit identity for the workers
GIT_AUTHOR_NAME="hungnc2-assistant"
GIT_AUTHOR_EMAIL="hungnc2@vng.com.vn"

# --- Miniapp backend (worker login UI) ---
# Any long random string. Generate one:  openssl rand -hex 24
# Required header on every API call: X-Api-Token
MINIAPP_API_TOKEN=

# --- OpenClaw gateway auth (internal only, never exposed) ---
# Any long random string. Generate one:  openssl rand -hex 24
OPENCLAW_GATEWAY_TOKEN=

# --- container limits (optional) ---
# Memory cap for the whole assistant container. Raise if sessions get killed.
OPENCLAW_MEM_LIMIT=2g

# NOTE: Claude Code and Codex do NOT go here.
# They authenticate with your subscriptions via one-time OAuth logins
# stored in ./data/claude and ./data/codex (see scripts/setup-acp.sh).

# --- Notion (task board) ---
# Integration key từ notion.so/my-integrations. Database id do setup-notion.sh điền.
NOTION_API_KEY=
NOTION_DB_ID=

# --- Notion (Personal Goal Dashboard) ---
# Hai id này do setup-goals.sh tự điền — không cần điền tay.
# NOTION_PERSONAL_DB_ID=   (database "Personal Tasks")
# NOTION_GOALS_DB_ID=      (database "Goals" — mục tiêu các line việc)
